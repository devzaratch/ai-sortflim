# ═══════════════════════════════════════════════════════════
# MOVIES AI — ตัวแปรแวดล้อมที่ต้องตั้ง
# คัดลอกไฟล์นี้เป็น .env.local (local) หรือใส่ค่าใน Vercel → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════

# ── Supabase (ต้องมี) ─────────────────────────────────────
# Project URL: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# anon / public key: Supabase Dashboard → Settings → API → Project API keys (anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key: ใช้ฝั่ง server เท่านั้น (สร้าง VIP, webhook)
# ⚠️ ห้าม commit / ห้ามเผยแพร่ — ถ้า key เคยหลุดออกไปแล้วให้ rotate ใน dashboard ก่อน
SUPABASE_SERVICE_ROLE_KEY=

# ── URL ของเว็บ (ต้องมี) ──────────────────────────────────
# ใช้ทำ metadataBase / sitemap / robots ใน production
# Vercel: ใส่ https://<โดเมนจริง> (เช่น https://movies-ai.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── ระบบชำระเงิน (ตั้งเมื่อพร้อมใช้จริง) ───────────────────
# ปิดการจำลอง VIP (endpoint /api/vip/activate) — ตั้ง false ใน production
ENABLE_VIP_SIMULATION=true

# secret สำหรับตรวจลายเซ็น webhook ของผู้ให้บริการชำระเงิน (ดู app/api/webhook/route.ts)
# สร้างได้ด้วย: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=
